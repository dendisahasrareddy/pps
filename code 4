#include <stdio.h>

int main()
{
    int n, i, j, temp;
    int marks[40], roll[40];
    int index[40];

    printf("Enter number of students (max 40): ");
    scanf("%d", &n);

    if (n < 1 || n > 40)
    {
        printf("Invalid number of students\n");
        return 0;
    }

    for (i = 0; i < n; i++)
    {
        printf("Enter roll number and final mark: ");
        scanf("%d%d", &roll[i], &marks[i]);

        if (marks[i] < -1 || marks[i] > 100)
        {
            printf("Invalid mark\n");
            return 0;
        }

        index[i] = i;
    }

    /* Insertion sort using index array */

    for (i = 1; i < n; i++)
    {
        temp = index[i];
        j = i - 1;

        while (j >= 0 && marks[index[j]] < marks[temp])
        {
            index[j + 1] = index[j];
            j--;
        }

        index[j + 1] = temp;
    }

    printf("\nStudent Ranking\n");
    printf("Rank\tRoll Number\tMark\n");

    for (i = 0; i < n; i++)
    {
        printf("%d\t%d\t\t%d\n",
               i + 1,
               roll[index[i]],
               marks[index[i]]);
    }

    return 0;
}