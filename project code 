#include <stdio.h>
#include <stdlib.h>
#include <pthread.h>
#include <semaphore.h>
#include <unistd.h>
#define BUFFER_SIZE 5
#define ITEMS_TO_PRODUCE 10
int buffer[BUFFER_SIZE];
int in = 0;   /* next insertion position */
int out = 0;  /* next removal position */
sem_t empty_slots;
sem_t filled_slots;
pthread_mutex_t mutex;
void *producer(void *arg) {
    (void)arg;
    for (int item = 1; item <= ITEMS_TO_PRODUCE; item++) {
        sem_wait(&empty_slots);      /* wait for an empty slot */
        pthread_mutex_lock(&mutex);     /* enter critical section */
        buffer[in] = item;
        printf("Producer produced: %d at position %d\n", item, in);
        in = (in + 1) % BUFFER_SIZE;
        pthread_mutex_unlock(&mutex);   /* leave critical section */
        sem_post(&filled_slots);      /* announce one filled slot */
        usleep(150000);
    }
    return NULL;
}
void *consumer(void *arg) {
    (void)arg;
    for (int count = 1; count <= ITEMS_TO_PRODUCE; count++) {
        sem_wait(&filled_slots);     /* wait for an available item */
        pthread_mutex_lock(&mutex);     /* enter critical section */
        int item = buffer[out];
        printf("Consumer consumed: %d from position %d\n", item, out);
        out = (out + 1) % BUFFER_SIZE;
        pthread_mutex_unlock(&mutex);   /* leave critical section */
        sem_post(&empty_slots);       /* announce one empty slot */
        usleep(250000);
    }
    return NULL;
}
int main(void) {
    pthread_t producer_thread, consumer_thread;
    sem_init(&empty_slots, 0, BUFFER_SIZE);
    sem_init(&filled_slots, 0, 0);
    pthread_mutex_init(&mutex, NULL);
    if (pthread_create(&producer_thread, NULL, producer, NULL) != 0 ||
        pthread_create(&consumer_thread, NULL, consumer, NULL) != 0) {
        fprintf(stderr, "Error creating threads.\n");
        return EXIT_FAILURE;
    }
    pthread_join(producer_thread, NULL);
    pthread_join(consumer_thread, NULL);
    sem_destroy(&empty_slots);
    sem_destroy(&filled_slots);
    pthread_mutex_destroy(&mutex);
    printf("\nSimulation completed successfully.\n");
    return EXIT_SUCCESS;
}