
#include <stdio.h>

int main()
{
    int n, i, roll, mark;
    int min = 101, max = -1;
    int minRoll = -1, maxRoll = -1;
    int minCount = 0, maxCount = 0;
    int validCount = 0;

    printf("Enter number of students: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++)
    {
        printf("Enter roll number and mark: ");
        scanf("%d%d", &roll, &mark);

        if (mark == -1)
            continue;

        if (mark < 0 || mark > 100)
        {
            printf("Invalid mark\n");
            continue;
        }

        validCount++;

        if (mark < min)
        {
            min = mark;
            minRoll = roll;
            minCount = 1;
        }
        else if (mark == min)
        {
            minCount++;
        }

        if (mark > max)
        {
            max = mark;
            maxRoll = roll;
            maxCount = 1;
        }
        else if (mark == max)
        {
            maxCount++;
        }
    }

    if (validCount == 0)
    {
        printf("No valid marks available\n");
    }
    else
    {
        printf("Minimum mark = %d\n", min);
        printf("First minimum roll number = %d\n", minRoll);
        printf("Minimum tie count = %d\n", minCount);

        printf("Maximum mark = %d\n", max);
        printf("First maximum roll number = %d\n", maxRoll);
        printf("Maximum tie count = %d\n", maxCount);
    }

    return 0;
}